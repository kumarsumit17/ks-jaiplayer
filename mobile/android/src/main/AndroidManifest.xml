<?xml version="1.0" encoding="utf-8"?>
<!-- The phone app. Permissions, the activity and its hand-off come from :shared; this adds the
     phone launcher entry. A separate Google TV app (tv/google-tv) has the same package name. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="com.ks.jaiplayer.android.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
